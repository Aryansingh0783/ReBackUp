{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pre-Reset Backup",
  "version": "0.1.0",
  "identifier": "dev.prereset.backup",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Pre-Reset Backup",
        "width": 1280,
        "height": 840,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark",
        "decorations": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/PreResetBackup_*/**", "$APPDATA/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "app", "dmg", "deb", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Pre-reset backup for Windows",
    "longDescription": "Scan your drives, pick what matters, and produce a verified, encrypted backup before a clean install.",
    "copyright": "Copyright (c) 2026 pre-reset-backup contributors",
    "licenseFile": "../LICENSE",
    "resources": ["assets/restore.ps1.tmpl"],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "certificateThumbprint": null,
      "wix": { "language": ["en-US"] },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    },
    "macOS": { "minimumSystemVersion": "10.15" },
    "linux": { "deb": { "depends": [] } }
  },
  "plugins": {}
}
